<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone adaptativo (Android 8+).

  Sem este arquivo o launcher tratava o ic_launcher.png quadrado como icone
  legado: encaixava o quadrado azul dentro da mascara circular sobre fundo
  branco. Com as duas camadas, o azul preenche o circulo inteiro e so a
  espiral aparece por cima.

  O <monochrome> alimenta os icones tematicos do Android 13+, que reaproveitam
  o alfa da espiral e a pintam com a cor do sistema.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
